generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model banks {
  id             String           @id @db.VarChar
  name_th        String?          @db.VarChar
  name_eng       String?          @db.VarChar
  logo_url       String?
  created_date   DateTime         @default(now()) @db.Timestamptz(6)
  created_by     String?          @db.VarChar
  updated_date   DateTime?        @db.Date
  updated_by     String           @db.VarChar
  color          String?          @db.VarChar
  initial        String?          @db.VarChar
  credit_cards   credit_cards[]
  point_programs point_programs[]
  promotions     promotions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model card_base_benefit {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  card_id               String       @db.Uuid
  category_id           String?      @db.Uuid
  benefit_type          String       @db.VarChar
  benefit_value         Decimal      @db.Decimal
  benefit_unit          String       @db.VarChar
  spend_per_unit        Decimal?     @db.Decimal
  min_spend             Decimal?     @db.Decimal
  max_cap               Decimal?     @db.Decimal
  cap_period            String?      @db.VarChar
  condition             String?
  effective_rate_pct    Decimal      @db.Decimal(8, 4)
  sort_order            Int          @default(0)
  created_date          DateTime     @default(now()) @db.Timestamptz(6)
  created_by            String?      @db.VarChar
  updated_date          DateTime?    @db.Timestamptz(6)
  updated_by            String?      @db.VarChar
  cap_basis             String?      @db.VarChar
  max_reward_thb        Decimal?     @db.Decimal(12, 2)
  min_spend_basis       String?      @db.VarChar
  requires_registration Boolean      @default(false)
  credit_cards          credit_cards @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories            categories?  @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([card_id], map: "idx_cbb_card")
  @@index([category_id], map: "idx_cbb_category")
  @@index([effective_rate_pct(sort: Desc)], map: "idx_cbb_rate")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model credit_cards {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_id              String?             @db.VarChar
  card_name            String?             @db.VarChar
  card_tier            String?             @db.VarChar
  image_url            String?
  created_date         DateTime            @default(now()) @db.Timestamptz(6)
  created_by           String?             @db.VarChar
  updated_date         DateTime?           @db.Timestamptz(6)
  updated_by           String?             @db.VarChar
  point_program_id     String?             @db.Uuid
  network              String?             @db.VarChar
  annual_fee           Decimal?            @db.Decimal(10, 2)
  fee_waiver_condition String?
  foreign_tx_fee_pct   Decimal?            @db.Decimal(5, 2)
  status               String              @default("active") @db.VarChar
  card_base_benefit    card_base_benefit[]
  card_perks           card_perks[]
  banks                banks?              @relation(fields: [bank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  point_programs       point_programs?     @relation(fields: [point_program_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotion_cards      promotion_cards[]
  users_card           users_card[]

  @@index([point_program_id], map: "idx_credit_cards_point_program")
  @@index([status], map: "idx_credit_cards_status", where: raw("((status)::text = 'active'::text)"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  token        String   @unique
  expires_at   DateTime @db.Timestamptz(6)
  created_date DateTime @default(now()) @db.Timestamptz(6)
  last_used_at DateTime @default(now()) @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_sessions_expires_at")
  @@index([token], map: "idx_sessions_token")
  @@index([user_id], map: "idx_sessions_user_id")
}

model users {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line_id      String?      @unique(map: "users_line_id_unique")
  display_name String?
  picture_url  String?
  created_date DateTime     @default(now()) @db.Timestamptz(6)
  created_by   String?      @db.VarChar
  updated_date DateTime?    @db.Timestamptz(6)
  updated_by   String?      @db.VarChar
  email        String?
  logto_sub    String?      @unique
  last_login   DateTime?    @db.Timestamptz(6)
  sessions     sessions[]
  users_card   users_card[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users_card {
  id                                                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                                   String?        @db.Uuid
  card_id                                                   String?        @db.Uuid
  created_date                                              DateTime       @default(now()) @db.Timestamptz(6)
  created_by                                                String?        @db.VarChar
  updated_date                                              DateTime?      @db.Timestamptz(6)
  updated_by                                                String?        @db.VarChar
  last_four                                                 String?        @db.VarChar(4)
  credit_limit                                              Decimal?       @db.Decimal(12, 2)
  billing_cycle_day                                         Int?
  billing_last_day                                          Boolean?       @default(false)
  payment_due_day                                           Int?
  payment_due_last_day                                      Boolean?       @default(false)
  sort_order                                                Int?
  transactions_transactions_recommended_card_idTousers_card transactions[] @relation("transactions_recommended_card_idTousers_card")
  transactions                                              transactions[]
  credit_cards                                              credit_cards?  @relation(fields: [card_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                     users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_th           String?             @db.VarChar
