  @@index([category_id], map: "idx_merchants_category")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model promotion_cards {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotion_id String       @db.Uuid
  card_id      String       @db.Uuid
  created_date DateTime     @default(now()) @db.Timestamptz(6)
  created_by   String?      @db.VarChar
  updated_date DateTime?    @db.Timestamptz(6)
  updated_by   String?      @db.VarChar
  credit_cards credit_cards @relation(fields: [card_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotions   promotions   @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([promotion_id, card_id])
  @@index([card_id], map: "idx_promo_cards_card")
  @@index([promotion_id], map: "idx_promo_cards_promo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model promotion_merchants {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promotion_id String     @db.Uuid
  merchant_id  String     @db.Uuid
  created_date DateTime   @default(now()) @db.Timestamptz(6)
  created_by   String?    @db.VarChar
  updated_date DateTime?  @db.Timestamptz(6)
  updated_by   String?    @db.VarChar
  merchants    merchants  @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotions   promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([promotion_id, merchant_id])
  @@index([merchant_id], map: "idx_promo_merchants_merchant")
  @@index([promotion_id], map: "idx_promo_merchants_promo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model promotions {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String                @db.VarChar
  description           String?
  promo_type            String?               @db.VarChar
  benefit_value         Decimal?              @db.Decimal
  benefit_unit          String?               @db.VarChar
  min_spend             Decimal?              @db.Decimal
  max_cap               Decimal?              @db.Decimal
  category_id           String?               @db.Uuid
  bank_id               String?               @db.VarChar
  start_date            DateTime?             @db.Date
  end_date              DateTime?             @db.Date
  condition             String?
  source_url            String?
  status                String?               @default("draft") @db.VarChar
  created_date          DateTime              @default(now()) @db.Timestamptz(6)
  created_by            String?               @db.VarChar
  updated_date          DateTime?             @db.Timestamptz(6)
  updated_by            String?               @db.VarChar
  card_scope            String                @default("all_bank") @db.VarChar
  requires_registration Boolean               @default(false)
  cap_period            String?               @db.VarChar
  cap_basis             String?               @db.VarChar
  max_cap_campaign      Decimal?              @db.Decimal
  effective_rate_pct    Decimal?              @db.Decimal(8, 4)
  promotion_cards       promotion_cards[]
  promotion_merchants   promotion_merchants[]
  banks                 banks?                @relation(fields: [bank_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories            categories?           @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bank_id], map: "idx_promotions_bank")
  @@index([category_id], map: "idx_promotions_category")
  @@index([status], map: "idx_promotions_status")
}

model bot_sessions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  line_user_id String   @unique @db.VarChar
  step         String   @db.VarChar
  data         Json     @default("{}")
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
}

model transactions {
  id                                                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users_card_id                                           String      @db.Uuid
  merchant_id                                             String?     @db.Uuid
  amount                                                  Decimal     @db.Decimal(12, 2)
  spent_at                                                DateTime    @default(now()) @db.Timestamptz(6)
  note                                                    String?
  created_date                                            DateTime    @default(now()) @db.Timestamptz(6)
  created_by                                              String?     @db.VarChar
  updated_date                                            DateTime?   @db.Timestamptz(6)
  updated_by                                              String?     @db.VarChar
  external_ref                                            String?     @db.VarChar
  is_reconciled                                           Boolean?    @default(false)
  reconciled_at                                           DateTime?   @db.Timestamptz(6)
  source                                                  String      @default("liff") @db.VarChar
  recommended_card_id                                     String?     @db.Uuid
  merchants                                               merchants?  @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_card_transactions_recommended_card_idTousers_card users_card? @relation("transactions_recommended_card_idTousers_card", fields: [recommended_card_id], references: [id], onUpdate: NoAction)
  users_card                                              users_card  @relation(fields: [users_card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([users_card_id], map: "idx_transactions_users_card")
  @@index([merchant_id], map: "idx_transactions_merchant")
  @@index([spent_at], map: "idx_transactions_spent_at")
  @@index([recommended_card_id], map: "idx_transactions_recommended", where: raw("(recommended_card_id IS NOT NULL)"))
  @@index([source], map: "idx_transactions_source")
}

